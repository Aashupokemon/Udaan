{
  "name": "udaan-app",
  "main": "src/index.js",
  "compatibility_date": "2025-07-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "NODE_ENV": "development",
    "FREEBUFF_CLIENT_ID": "0816fffd-2943-4d64-a528-268418bc3768",
    "FREEBUFF_ISSUER": "https://freebuff.com/oidc",
    "APP_ORIGIN": "http://localhost:8787"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "data/udaan.db"
    }
  ]
}
